## KernelSU: keep the shim's $TMPDIR (under /data, persistent and large);
## Magisk's /dev/tmp is a tmpfs that may be too small for the unpack step.
if ! $KSU_INSTALL; then
  TMPDIR=/dev/tmp
fi
rm -rf $TMPDIR/nethunter
mkdir -p $TMPDIR
chcon u:object_r:system_file:s0 $TMPDIR
cd $TMPDIR

if ! $KSU_INSTALL; then
  setup_flashable
  mount_partitions || true
  api_level_arch_detect

  ## Setup BusyBox and binaries
  boot_actions
fi

## Extract prop file
unzip -o "$ZIPFILE" module.prop -d $TMPDIR >&2 || print "! Failed to extract"
[ ! -f $TMPDIR/module.prop ] && abort "! Unable to extract zip file!"

## Extract post-fs-data script
unzip -o "$ZIPFILE" post-fs-data.sh -d $TMPDIR >&2
[ ! -f $TMPDIR/module.prop ] && abort "! Unable to extract zip file!"

MODDIRNAME=modules_update
MODULEROOT=/data/adb/$MODDIRNAME
MODID=$(grep_prop id $TMPDIR/module.prop)
MODNAME=$(grep_prop name $TMPDIR/module.prop)
MODAUTH=$(grep_prop author $TMPDIR/module.prop)
## KernelSU: keep the shim-provided $MODPATH (/data/adb/modules_update/<id>,
## already populated with the extracted module)
if ! $KSU_INSTALL; then
  MODPATH=$MODULEROOT/$MODID
fi

## Create mod paths
## KernelSU: MODPATH was already created by the installer shim and contains
## the extracted module (minus META-INF/*); don't wipe it here, our staged
## files land inside $MODPATH/system below.
if ! $KSU_INSTALL; then
  rm -rf $MODPATH
fi
mkdir -p $MODPATH || abort "! Unable to: mkdir -p $MODPATH"
#</REF: ./scripts/util_functions.sh>

## Define several variables
[ -z "$TMPDIR" ] && TMPDIR=/dev/tmp
[ -n "${ZIP:-}" ] && { ZIPFILE="$ZIP"; unset ZIP; }
[ -z "$ZIPFILE" ] && ZIPFILE="${3:-}"
DIR=$(dirname "$ZIPFILE")
TMP=$TMPDIR/$MODID

## Magisk manager/booted flashing support
## KernelSU: the shim exports OUTFD (stdout pipe); don't clobber it
OUTFD=${OUTFD:-/proc/self/fd/0}
if $KSU_INSTALL; then
  ## KernelSU: ksud's installer shim already prepends its busybox to PATH
  [ -e /data/adb/ksu/bin/busybox ] && export PATH="/data/adb/ksu/bin/busybox:$PATH"
elif [ -e /data/adb/magisk ]; then
  ADB=adb
  if [ -e /data/$ADB/magisk ]; then
    [ -e /magisk/.core/busybox ] && MAGISKBB=/magisk/.core/busybox
    [ -e /sbin/.core/busybox ] && MAGISKBB=/sbin/.core/busybox
    [ -e /sbin/.magisk/busybox ] && MAGISKBB=/sbin/.magisk/busybox
    [ -e /dev/*/.magisk/busybox ] && MAGISKBB=$(echo /dev/*/.magisk/busybox)
    [ -e /data/$ADB/ksu/bin/busybox ] && MAGISKBB=/data/$ADB/ksu/bin/busybox
    [ -e /data/$ADB/ap/bin/busybox ] && MAGISKBB=/data/$ADB/ap/bin/busybox
    [ "$MAGISKBB" ] && export PATH="$MAGISKBB:$PATH"
    [ "$MAGISKBB" ] \
      && debug "MAGISKBB: $MAGISKBB" \
      || debug "Inside of Magisk without BusyBox"
  elif [ ! -f "$MAGISKBB" ]; then
    debug "Not inside of Magisk?"
  fi
fi

## Define modules target dirs
if [ -e /data/adb/modules ]; then
  MNT=/data/adb/modules_update
  MAGISK=/$MODID/system
fi

## Set target paths
## KernelSU: keep the shim-provided $MODPATH (it is where the module was
## extracted and where the manager expects the module to live).
if ! $KSU_INSTALL; then
  [ ! -z $MODPTH ] || MODPATH=$MNT/$MODID
fi
TARGET=$MODPATH/system
ETC=$TARGET/etc
BIN=$TARGET/bin

if [ -d /system/xbin ]; then
  XBIN=$TARGET/xbin
else
  XBIN=$TARGET/bin
fi

if [ -d /system/media ]; then
  MEDIA=$TARGET/media
elif [ -d /system/product/media ]; then
  MEDIA=$TARGET/product/media
fi

UMASK=$(umask)
