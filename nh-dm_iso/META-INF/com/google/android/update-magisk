SAR=false
if ! $KSU_INSTALL; then
  if [ -d /dev/block/mapper ]; then
    for block in system; do
      for slot in "" _a _b; do
        blockdev --setrw /dev/block/mapper/$block$slot 2>/dev/null
      done
    done
    DYNAMIC=true
  fi
  mount -o rw,remount -t auto /system || mount /system || true
